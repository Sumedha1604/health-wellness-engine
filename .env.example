# Docker Compose and production deployment configuration.
# Copy this file to .env and replace every placeholder before deployment.

# Public URL used when building the frontend. This value is embedded at build time.
VITE_API_URL=https://api.example.com/api
FRONTEND_PORT=4173
BACKEND_PORT=5050
ML_SERVICE_PORT=8000

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_a_long_unique_root_password
MYSQL_DATABASE=health_wellness
MYSQL_USER=wellness_app
MYSQL_PASSWORD=replace_with_a_long_unique_database_password
# Keep false in production. Set true only for local Docker development.
SEED_DEVELOPMENT_DATA=false

# Backend
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_jwt_secret
CORS_ORIGIN=https://app.example.com
ML_SERVICE_URL=http://ml-service:8000

# Optional Groq assistant integration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
