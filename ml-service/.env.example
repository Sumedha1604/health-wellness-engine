# ML service runtime configuration. Copy to ml-service/.env for a non-Docker
# setup, or configure the same values in the deployment platform.
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# MySQL connection for collaborative and deep recommendation features.
DB_HOST=replace_with_database_host
DB_PORT=3306
DB_USER=wellness_app
DB_PASSWORD=replace_with_database_password
DB_NAME=health_wellness
