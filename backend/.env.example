# Backend runtime configuration. Copy to backend/.env for a non-Docker setup.
NODE_ENV=production
PORT=5001

# MySQL connection
DB_HOST=replace_with_database_host
DB_PORT=3306
DB_USER=wellness_app
DB_PASSWORD=replace_with_database_password
DB_NAME=health_wellness

# Security and browser access. Add multiple trusted frontend origins as a
# comma-separated list when needed.
JWT_SECRET=replace_with_a_long_random_jwt_secret
CORS_ORIGIN=https://app.example.com

# ML service URL. Use a private service URL when the deployment platform
# supports internal networking.
ML_SERVICE_URL=https://ml.example.com

# Optional Groq assistant integration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
